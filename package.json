{
  "name": "code-sync-studio",
  "version": "1.0.10",
  "private": true,
  "description": "Git and SVN pull/update desktop utility",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "electron .",
    "package": "node scripts/package.cjs"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "^33.4.11",
    "electron-builder": "latest",
    "vite": "latest"
  },
  "build": {
    "appId": "com.codesync.studio",
    "productName": "CodeSync Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release-codesync"
    },
    "asar": false,
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/codesync-sakura.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
